# Claude Code workspace ignore file
# Ignore everything first
*

# Allow directory traversal
!*/

# Allow only these specific directories and their contents
!data_conversion/
!data_conversion/**
!docs/
!docs/**
!eval/
!eval/**
!configs/
!configs/**
!data/
!data/**
!src/
!src/**
!scripts/
!scripts/**
!tests/
!tests/**
!src_new/
!src_new/**
!run_new.log
!vis_tools/
!vis_tools/**
!todo/
!todo/**
!.augment-guidelines
!src_coord_pretrain/**/*.py
!src_coord_pretrain/**/*.sh
!src_coord_pretrain/**/*.yaml
!src_coord_pretrain/**/*.md

# Allow essential root files
!.gitignore
!CLAUDE.md
!README.md

# Ignore all other directories and files at root level except the allowed ones
/.claude
**/__pycache__/
/.cursor
/.git
/.kiro
/.pytest_cache
/.ruff_cache
/.serena
/.swarm
/.trae
/.vscode
/data_analysis
/data_templates
/demo
/ds_v1
/ds_v2
/examples
/exp_det_coordinates
/good_results
/important_demo
/legacy
/logs
/model_cache
/output*
/output-*
/raw_ds
/tasks
/tb
/temporal
/test_output
/专利
**/*.jpeg
**/*.jpg
**/*.png