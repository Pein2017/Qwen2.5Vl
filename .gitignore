# ignore everything at root
/*

# keep the .gitignore itself
!/.gitignore

# allow these top-level dirs and everything under them
!/src/
!/data_conversion/
!/data_analysis/
!/eval/
!/scripts/
!/docs/
!/ongoing_task/
!/configs/
!/important_demo/
!/vis_tools/
!/temporal/
!/ds_v2_clean/
!/ds_*/

# allow logs & markdown at root
!/*.log
!/*.md

# drop all __pycache__ dirs
**/__pycache__/
